---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE, OUTCOMES } from '../data/site';
import { PHASES, ENTRIES } from '../data/timeline';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const marks = ENTRIES.filter((e) => e.mark).length;
---

<Base title={SITE.course} description={SITE.tagline}>
  <p class="kicker">{SITE.course} / {SITE.term} / {SITE.author}</p>

  <h1>Same question, five months apart.</h1>

  <div class="then-now">
    <figure>
      <figcaption>June 18 — my first prompt of the semester</figcaption>
      <pre>what programming language or framework or game
engine should i create this on</pre>
      <p>Came back as three questions, because my skill level, my platform and my priority were the facts that decided the answer and none of them were in the prompt.</p>
    </figure>

    <figure class="now">
      <figcaption>November 4 — a prompt for the same kind of decision</figcaption>
      <pre>You are the decision engine for an off-grid
smart-agriculture monitoring network.
You receive data for ONE sensor node and must
return ONE JSON object. You only advise. A separate
controller decides whether to execute your actions.

1. Use ONLY the data in NODE DATA. Anything not
   provided (rainfall, water tank level, forecast,
   valve state) is UNKNOWN. Never invent values.</pre>
      <p>Role, input bound, output bound, authority limited, and the absent fields named one by one so the model has something true to say instead of a guess.</p>
    </figure>
  </div>

  <p class="hero-after">
    Between those two prompts are about forty conversations. This site is all of
    them, in order, with the {marks} points where something actually changed.
  </p>

  <h2 id="phases">Five phases</h2>
  <ol class="phases">
    {PHASES.map((p) => (
      <li>
        <a class="phases__n" href={`/timeline#${p.id}`}>{p.n}</a>
        <div>
          <h3>{p.name}</h3>
          <p class="phases__range">{p.range}</p>
          <p class="phases__move">{p.move}</p>
        </div>
      </li>
    ))}
  </ol>

  <p class="cta"><a href="/timeline">Read the timeline</a></p>

  <h2 id="outcomes">What I can now claim</h2>
  <p>
    The course has four learning outcomes. Rather than restate them, here is
    what I would say if you asked me what I can do, with the work behind each.
  </p>

  <ol class="claims">
    {OUTCOMES.map((o) => (
      <li>
        <a class="claims__id" href={`/outcomes#${o.id}`}>CLO{o.n}</a>
        <p class="claims__short">{o.short}</p>
        <p class="claims__claim">{o.claim}</p>
      </li>
    ))}
  </ol>

  <h2 id="work">Six written up in full</h2>
  <ol class="index">
    {work.map((w) => (
      <li>
        <h3><a href={`/work/${w.id}`}>{w.data.title}</a></h3>
        <p class="index__sub">{w.data.subtitle}</p>
        <p class="index__sum">{w.data.summary}</p>
        <ul class="tags">
          {w.data.outcomes.map((id) => (
            <li><span class="tag tag--clo">CLO{id.replace('clo', '')}</span></li>
          ))}
          {w.data.techniques.slice(0, 3).map((t) => <li><span class="tag">{t}</span></li>)}
        </ul>
      </li>
    ))}
  </ol>
</Base>

<style>
  h1 { max-width: 18ch; }

  .then-now { display: grid; gap: 1.75rem; margin: 2.5rem 0 1.5rem; max-width: min(100%, 54rem); }
  .then-now figure { margin: 0; border-top: 1px solid var(--rule); padding-top: 0.75rem; }
  .then-now .now { border-top-color: var(--flag); }
  .then-now figcaption {
    font-family: var(--mono);
    font-size: var(--t-xs);
    color: var(--ink-3);
    margin-bottom: 0.7rem;
  }
  .then-now .now figcaption { color: var(--flag); }
  .then-now pre {
    margin: 0 0 0.8rem;
    border: 0;
    border-left: 2px solid var(--rule);
    background: var(--field-2);
    font-size: var(--t-sm);
    padding: 0.8rem 0.9rem;
    white-space: pre-wrap;
  }
  .then-now p { margin: 0; font-size: var(--t-base); color: var(--ink-2); max-width: 46ch; }

  @media (min-width: 52rem) {
    .then-now { grid-template-columns: 1fr 1fr; gap: 2rem; }
  }

  .hero-after { font-size: var(--t-base); color: var(--ink-2); max-width: 58ch; }

  .phases { list-style: none; padding: 0; margin: 2rem 0 0; max-width: min(100%, 52rem); border-top: 1px solid var(--rule); }
  .phases li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0 1.25rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--rule-soft);
    margin: 0;
  }
  .phases__n {
    font-family: var(--mono);
    font-size: var(--t-md);
    color: var(--verify);
    text-decoration: none;
    padding-top: 0.1rem;
  }
  .phases__n:hover { color: var(--flag); }
  .phases h3 { margin: 0; font-size: var(--t-md); }
  .phases__range { font-family: var(--mono); font-size: var(--t-xs); color: var(--ink-3); margin: 0.15rem 0 0.5rem; }
  .phases__move { margin: 0; font-size: var(--t-base); color: var(--ink-2); max-width: 58ch; }

  .cta { margin: 1.5rem 0 0; }
  .cta a { font-family: var(--mono); font-size: var(--t-base); }

  .claims { list-style: none; padding: 0; margin: 2rem 0 0; max-width: min(100%, 52rem); border-top: 1px solid var(--rule); }
  .claims li { display: grid; gap: 0.1rem 1.75rem; padding: 1.25rem 0; border-bottom: 1px solid var(--rule-soft); margin: 0; }
  .claims__id { font-family: var(--mono); font-size: var(--t-xs); color: var(--verify); text-decoration: none; border-bottom: 1px solid transparent; justify-self: start; }
  .claims__id:hover { border-bottom-color: currentColor; }
  .claims__short { font-family: var(--mono); font-size: var(--t-sm); color: var(--ink-3); margin: 0; }
  .claims__claim { margin: 0.4rem 0 0; font-size: var(--t-base); max-width: 62ch; }

  @media (min-width: 46rem) {
    .claims li { grid-template-columns: 4rem minmax(0, 1fr); }
    .claims__id { grid-row: span 2; padding-top: 0.3rem; }
    .claims__claim { margin-top: 0.25rem; }
  }

  .index { list-style: none; padding: 0; margin: 2rem 0 0; counter-reset: cs; max-width: min(100%, 52rem); }
  .index li { counter-increment: cs; border-top: 1px solid var(--rule); padding: 1.5rem 0 1.75rem; position: relative; margin: 0; }
  .index h3 { margin: 0 0 0.3rem; font-size: var(--t-md); }
  .index h3 a { text-decoration: none; border-bottom: 1px solid var(--rule); }
  .index h3 a:hover { border-bottom-color: var(--flag); }
  .index__sub { font-family: var(--mono); font-size: var(--t-sm); color: var(--ink-3); margin: 0 0 0.7rem; }
  .index__sum { margin: 0 0 0.9rem; font-size: var(--t-base); color: var(--ink-2); }

  @media (min-width: 46rem) {
    .index li { padding-left: 4rem; }
    .index li::before {
      content: counter(cs, decimal-leading-zero);
      position: absolute; left: 0; top: 1.6rem;
      font-family: var(--mono); font-size: var(--t-sm); color: var(--ink-3);
    }
  }
</style>
