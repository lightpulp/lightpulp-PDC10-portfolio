---
import { SITE, OUTCOMES } from '../data/site';
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const nav = [
  { href: '/', label: 'Overview' },
  { href: '/timeline', label: 'Timeline' },
  { href: '/outcomes', label: 'Outcomes' },
  { href: '/work', label: 'Case studies' },
  { href: '/prompts', label: 'Prompt library' },
  { href: '/reflection', label: 'Reflection' },
];
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<nav class="spine" aria-label="Site">
  <a class="spine__mark" href="/">
    PDC10
    <span>{SITE.author}</span>
  </a>

  <div class="spine__nav">
    {nav.map((n) => (
      <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
    ))}
  </div>

  <div class="spine__outcomes">
    <p>Course learning outcomes</p>
    <ol>
      {OUTCOMES.map((o) => <li>{o.short}</li>)}
    </ol>
  </div>
</nav>
